# ==============================================================================
# TechMind — .gitignore Principal
# ==============================================================================

# ── Entornos Virtuales de Python ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Archivos de Bytecode y Caché de Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Variables de Entorno y Secretos Locales ───────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Artefactos de Compilación de Java / Maven (Spring Boot) ───────────────────
**/target/
**/*.class
**/*.war
**/*.ear
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# Excluir .jar compilados EXCEPTO los de Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar

# ── Archivos Basura del Sistema Operativo ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Archivos de Configuración de IDEs y Editores ──────────────────────────────
.idea/
.vscode/
.gemini/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Node.js / Frontend (Si aplica) ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Excepciones Explícitas (Asegurar que los modelos y datos se suban a GitHub) ───
# CRÍTICO: Los archivos .joblib son los modelos de ML entrenados.
# Sin ellos el microservicio FastAPI no puede iniciar en Docker ni en local.
data-science/models/
!data-science/models/
!data-science/models/*.joblib
!data-science/data/raw/*.csv
